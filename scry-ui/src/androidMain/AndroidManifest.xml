<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Declared by the library so integrating apps register nothing.
          exported=false: this exposes captured request bodies and, later, the
          app's preferences and databases. No other app may launch it.
        -->
        <activity
            android:name="io.github.akhilesh2491.scry.ui.ScryActivity"
            android:exported="false"
            android:label="Scry"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!--
          The optional launcher-drawer icon. Ships disabled: enabling it is a
          deliberate call to ScryLauncherIcon.enable(), because the launcher can
          only start an exported component and this one forwards to the activity
          above. See ScryLauncherActivity for why it is a trampoline.
        -->
        <activity
            android:name="io.github.akhilesh2491.scry.ui.ScryLauncherActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/scry_ic_drawer"
            android:label="Scry"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
