<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SampleApplication"
        android:label="Scry sample"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Deliberately slow to draw and janky to scroll, for the perf plugin. -->
        <activity
            android:name=".PerfDemoActivity"
            android:exported="false" />

        <!-- Proves the Java installation path compiles and runs. -->
        <activity
            android:name=".JavaSetupActivity"
            android:exported="false" />

    </application>

</manifest>
