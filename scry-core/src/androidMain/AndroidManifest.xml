<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      For the launcher notification. Merged into debug variants only, because the
      Gradle plugin puts scry-core on debugImplementation and the no-op — which
      declares nothing — takes its place in release.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          Authority is derived from the host app id so it cannot collide with a
          FileProvider the app already declares. exported=false with
          grantUriPermissions: only the app the user picks in the share sheet
          gets read access, and only to the single report file.
        -->
        <provider
            android:name="io.github.akhilesh2491.scry.core.ScryFileProvider"
            android:authorities="${applicationId}.scry.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <!--
              Required, despite ScryFileProvider passing the same resource to
              FileProvider's constructor. The static getUriForFile() resolves a
              path strategy by reading this meta-data off the manifest — it never
              instantiates the provider subclass — so without this element every
              export failed with "Missing android.support.FILE_PROVIDER_PATHS".
            -->
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/scry_file_paths" />
        </provider>

        <!--
          Backs the launcher notification's "Clear data" action. exported=false:
          it wipes captured data, and nothing outside this app may ask for that.
        -->
        <receiver
            android:name="io.github.akhilesh2491.scry.core.ScryLauncherReceiver"
            android:exported="false" />
    </application>

</manifest>
